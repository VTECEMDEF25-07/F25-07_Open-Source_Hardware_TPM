+// Transport hardening only: preserve the original test transactions and suites.
+static void transport_failure(const char *what) {
+    fprintf(stderr,"TRANSPORT FAILURE: %s\n",what);
+    if (_connected) { SPI_CloseChannel(_handle); _connected=0; }
+    exit(2);
+}
+static void checked_write(FT_HANDLE h, unsigned char *b, DWORD n, DWORD *done, DWORD options) {
+    FT_STATUS status=SPI_Write(h,b,n,done,options);
+    if(status!=FT_OK || *done!=n) transport_failure("SPI_Write status/short transfer");
+}
+static void checked_read(FT_HANDLE h, unsigned char *b, DWORD n, DWORD *done, DWORD options) {
+    FT_STATUS status=SPI_Read(h,b,n,done,options);
+    if(status!=FT_OK || *done!=n) transport_failure("SPI_Read status/short transfer");
+}
+static void checked_readwrite(FT_HANDLE h, unsigned char *in, unsigned char *out, DWORD n, DWORD *done, DWORD options) {
+    FT_STATUS status=SPI_ReadWrite(h,in,out,n,done,options);
+    if(status!=FT_OK || *done!=n) transport_failure("SPI_ReadWrite status/short transfer");
 }
 
