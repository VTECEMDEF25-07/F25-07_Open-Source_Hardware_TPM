# Filename: de25_soc_top.qsf
# Author: Aaron Grossman
# Date: 2026-10-14
# General Description: Connects the TPM to DE25 pins, related clocks, reset and independent cooling.

set_global_assignment -name FAMILY "Agilex 5"
set_global_assignment -name DEVICE A5ED013BB32AE4SCS
set_global_assignment -name DEVICE_FILTER_PACKAGE VPBGA
set_global_assignment -name USE_CONF_DONE SDM_IO16
set_global_assignment -name USE_HPS_COLD_RESET SDM_IO11
set_global_assignment -name USE_INIT_DONE SDM_IO13
set_global_assignment -name STRATIXV_CONFIGURATION_SCHEME "ACTIVE SERIAL X4"
set_global_assignment -name ACTIVE_SERIAL_CLOCK AS_FREQ_100MHZ
set_global_assignment -name DEVICE_INITIALIZATION_CLOCK OSC_CLK_1_125MHZ
set_global_assignment -name PWRMGT_VOLTAGE_OUTPUT_FORMAT "LINEAR FORMAT"
set_global_assignment -name PWRMGT_LINEAR_FORMAT_N "-12"
set_global_assignment -name BOARD default
set_global_assignment -name POWER_APPLY_THERMAL_MARGIN ADDITIONAL
set_global_assignment -name TOP_LEVEL_ENTITY de25_soc_top
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name NUM_PARALLEL_PROCESSORS 6
set_global_assignment -name RESERVE_ALL_UNUSED_PINS "AS INPUT TRI-STATED"
set_global_assignment -name SDC_FILE de25_soc_top.sdc
set_global_assignment -name SDC_FILE "../spi_timing.sdc"
set_location_assignment PIN_CH128 -to clock_i
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to clock_i
set_location_assignment PIN_BW59 -to board_reset_n_i
set_instance_assignment -name IO_STANDARD "1.2-V" -to board_reset_n_i
# Select the USB adapter or Lenovo Raspberry Pi tester in de25_spi_pins.tcl.
source de25_spi_pins.tcl
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to spi_clock_i
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to spi_cs_n_i
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to spi_mosi_i
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to spi_reset_n_i
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to spi_miso_o
# IRQ stays on JP1 pin 2; leave purple disconnected for the Pi tester.
set_location_assignment PIN_BE43 -to interrupt_n_o
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to interrupt_n_o
set_location_assignment PIN_BF120 -to fan_i2c_scl
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to fan_i2c_scl
set_location_assignment PIN_BH118 -to fan_i2c_sda
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to fan_i2c_sda
set_global_assignment -name SEARCH_PATH "../../Source Code/IO Interface"
set_global_assignment -name VERILOG_FILE "de25_soc_top.v"
set_global_assignment -name VERILOG_FILE "../../Source Code/Display/hps_lcd_island.v"
# Fully generated source: include system wrapper AND its separately generated IP QIP.
set_global_assignment -name QIP_FILE "../DE25_HPS_LCD/hps_lcd_subsys/hps_lcd_subsys.qip"
set_global_assignment -name QIP_FILE "../DE25_HPS_LCD/ip/hps_lcd_subsys/hps_lcd_subsys_agilex_hps/hps_lcd_subsys_agilex_hps.qip"
# Fixed HPS_LOCATION/1.8V bindings are carried by the generated IP QIP.
set_global_assignment -name VERILOG_FILE "de25_clock.v"
set_global_assignment -name VERILOG_FILE "../../Source Code/TPM_TOP.v"
set_global_assignment -name VERILOG_FILE "../../Source Code/Management Module/management_module.v"
set_global_assignment -name VERILOG_FILE "../../Source Code/Execution Engine/execution_engine.v"
set_global_assignment -name VERILOG_FILE "../../Source Code/IO Interface/fifo_buffer.v"
set_global_assignment -name VERILOG_FILE "../../Source Code/IO Interface/spi_slave.v"
set_global_assignment -name VERILOG_FILE "../../Source Code/IO Interface/tpm_crb.v"
set_global_assignment -name VERILOG_FILE "../../Source Code/IO Interface/tpm_io.v"
set_global_assignment -name VERILOG_FILE "../../Source Code/IO Interface/tpm_reg_space.v"
set_global_assignment -name VERILOG_FILE "../../Source Code/IO Interface/tpm_spi_ctrl.v"
set_global_assignment -name VERILOG_FILE "Fan Controller/altera_s10_user_rst_clkgate.v"
set_global_assignment -name VERILOG_FILE "Fan Controller/auto_fan.v"
set_global_assignment -name VERILOG_FILE "Fan Controller/BOARD_MANAGEMENT.v"
set_global_assignment -name VERILOG_FILE "Fan Controller/CLOCKMEM.v"
set_global_assignment -name VERILOG_FILE "Fan Controller/fan_timer.v"
set_global_assignment -name VERILOG_FILE "Fan Controller/I2C_READ_DATA.v"
set_global_assignment -name VERILOG_FILE "Fan Controller/I2C_WRITE_BYTE.v"
set_global_assignment -name VERILOG_FILE "Fan Controller/I2C_WRITE_POINTER.v"
set_instance_assignment -name SYNCHRONIZER_IDENTIFICATION "FORCED IF ASYNCHRONOUS" -to {tpm_release_reg[*]}
set_instance_assignment -name SYNCHRONIZER_IDENTIFICATION "FORCED IF ASYNCHRONOUS" -to {board_release_reg[*]}
set_global_assignment -name LAST_QUARTUS_VERSION "26.1.0 Pro Edition"
set_global_assignment -name RESERVE_ALL_UNUSED_PINS_NO_OUTPUT_GND "AS INPUT TRI-STATED"

# Keygen implementation choice and inactive placeholder dependencies.
set_global_assignment -name VERILOG_FILE "../../Source Code/Key Generation/IP/keygen_mult32.v"
set_global_assignment -name VERILOG_FILE "../../Source Code/Key Generation/IP/keygen_mult32_altera.v"
set_global_assignment -name VERILOG_FILE "../../Source Code/Key Generation/IP/keygen_mult32_generic.v"
set_global_assignment -name VERILOG_FILE "../../Source Code/Key Generation/IP/keygen_ram32.v"
set_global_assignment -name VERILOG_FILE "../../Source Code/Key Generation/IP/keygen_ram32_altera.v"
set_global_assignment -name VERILOG_FILE "../../Source Code/Key Generation/IP/keygen_ram32_generic.v"
set_global_assignment -name VERILOG_FILE "../../Source Code/Key Generation/rtl/aes/keygen_aes_core.v"
set_global_assignment -name VERILOG_FILE "../../Source Code/Key Generation/rtl/arithmetic/keygen_math.v"
set_global_assignment -name VERILOG_FILE "../../Source Code/Key Generation/rtl/arithmetic/keygen_pair_check.v"
set_global_assignment -name VERILOG_FILE "../../Source Code/Key Generation/rtl/common/keygen_core.v"
set_global_assignment -name VERILOG_FILE "../../Source Code/Key Generation/rtl/rsa_rtl/keygen_rsa_controller.v"
set_global_assignment -name VERILOG_FILE "../../Source Code/Key Generation/rtl/rsa_rtl/keygen_rsa_engine.v"
set_global_assignment -name VERILOG_FILE "../../Source Code/Key Generation/rtl/rsa_rtl/keygen_rsa_services.v"

# Shared SHA-256 command backend.
set_global_assignment -name VERILOG_FILE "../../Source Code/Hash Module/hash_arbiter.v"
set_global_assignment -name VERILOG_FILE "../../Source Code/Hash Module/hash_engine.v"
set_global_assignment -name VERILOG_FILE "../../Source Code/Hash Module/hash_subsystem.v"
set_global_assignment -name VERILOG_FILE "../../Source Code/Hash Module/hmac_sha256.v"
set_global_assignment -name VERILOG_FILE "../../Source Code/Hash Module/input_buffer.v"
set_global_assignment -name VERILOG_FILE "../../Source Code/Hash Module/message_schedule.v"
set_global_assignment -name VERILOG_FILE "../../Source Code/Hash Module/padding.v"
set_global_assignment -name VERILOG_FILE "../../Source Code/Hash Module/pcr_controller.v"
set_global_assignment -name VERILOG_FILE "../../Source Code/Hash Module/pcr_registers.v"
set_global_assignment -name VERILOG_FILE "../../Source Code/Hash Module/round_operations.v"
set_global_assignment -name VERILOG_FILE "../../Source Code/Hash Module/sha256_controller.v"
set_global_assignment -name VERILOG_FILE "../../Source Code/Hash Module/sha_256.v"
set_instance_assignment -name SYNCHRONIZER_IDENTIFICATION "FORCED IF ASYNCHRONOUS" -to "tpm|io|spi_serializer|chip_select_meta_reg"
set_instance_assignment -name SYNCHRONIZER_IDENTIFICATION "FORCED IF ASYNCHRONOUS" -to "tpm|io|spi_serializer|chip_select_sync_reg"
set_instance_assignment -name SYNCHRONIZER_IDENTIFICATION "FORCED IF ASYNCHRONOUS" -to "tpm|io|spi_serializer|rx_meta_reg"
set_instance_assignment -name SYNCHRONIZER_IDENTIFICATION "FORCED IF ASYNCHRONOUS" -to "tpm|io|spi_serializer|rx_sync_reg"
set_instance_assignment -name SYNCHRONIZER_IDENTIFICATION "FORCED IF ASYNCHRONOUS" -to "tpm|io|spi_serializer|request_meta_reg"
set_instance_assignment -name SYNCHRONIZER_IDENTIFICATION "FORCED IF ASYNCHRONOUS" -to "tpm|io|spi_serializer|request_sync_reg"
set_instance_assignment -name SYNCHRONIZER_IDENTIFICATION "FORCED IF ASYNCHRONOUS" -to "tpm|io|spi_serializer|ack_meta_reg"
set_instance_assignment -name SYNCHRONIZER_IDENTIFICATION "FORCED IF ASYNCHRONOUS" -to "tpm|io|spi_serializer|ack_sync_reg"
set_instance_assignment -name SYNCHRONIZER_IDENTIFICATION "FORCED IF ASYNCHRONOUS" -to "tpm|io|spi_serializer|offer_meta_reg"
set_instance_assignment -name SYNCHRONIZER_IDENTIFICATION "FORCED IF ASYNCHRONOUS" -to "tpm|io|spi_serializer|offer_sync_reg"
set_instance_assignment -name FAST_INPUT_REGISTER OFF -to "spi_mosi_i"
set_instance_assignment -name FAST_OUTPUT_REGISTER OFF -to "spi_miso_o"

# Use ordinary fabric registers so the pin-clocked front end can use local SCK routing.
set_instance_assignment -name GLOBAL_SIGNAL OFF -to "spi_clock_i"

# Frozen v0.1 explicit demo build; default RTL parameters remain disabled.
set_parameter -name ENABLE_DEMO_COMMANDS 1
set_parameter -name DEMO_PROVIDER_MODE 0
set_parameter -name DEMO_MODEXP_WIDTH 2048
set_parameter -name CUSTOMER_DEMO_ENABLE 1
set_parameter -name DEMO_AES_EXPORT_ENABLE 1
set_global_assignment -name VERILOG_FILE "../../Source Code/Execution Engine/customer_crypto_subsystem.v"
set_global_assignment -name VERILOG_FILE "../../Source Code/Execution Engine/customer_demo_packet.v"
