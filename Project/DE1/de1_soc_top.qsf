# Filename: de1_soc_top.qsf
# Authors: Aaron Grossman (keygen placeholder dependencies); project contributors.
# Author: Aaron Grossman
# Date: 2026-10-14
# General Description: Defines the board FPGA, pins, source files and build settings.

# DE1-SoC pins: Terasic User Manual, tables 3-5, 3-7, 3-8 and 3-11.
set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSEMA5F31C6
set_global_assignment -name TOP_LEVEL_ENTITY de1_soc_top
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name NUM_PARALLEL_PROCESSORS 6
set_global_assignment -name RESERVE_ALL_UNUSED_PINS "AS INPUT TRI-STATED"
set_global_assignment -name SDC_FILE de1_soc_top.sdc
set_global_assignment -name SEARCH_PATH "../../Source Code/IO Interface"
set_location_assignment PIN_AF14 -to "CLOCK_50"
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to "CLOCK_50"
set_location_assignment PIN_AA14 -to "RESET_N"
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to "RESET_N"
set_location_assignment PIN_AB21 -to "GPIO_1_2"
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to "GPIO_1_2"
set_location_assignment PIN_AC23 -to "GPIO_1_3"
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to "GPIO_1_3"
set_location_assignment PIN_AD24 -to "GPIO_1_4"
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to "GPIO_1_4"
set_location_assignment PIN_AE23 -to "GPIO_1_5"
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to "GPIO_1_5"
set_location_assignment PIN_AE24 -to "GPIO_1_6"
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to "GPIO_1_6"
set_location_assignment PIN_AF25 -to "GPIO_1_7"
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to "GPIO_1_7"
set_location_assignment PIN_V16 -to "LEDR[0]"
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to "LEDR[0]"
set_location_assignment PIN_W16 -to "LEDR[1]"
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to "LEDR[1]"
set_location_assignment PIN_V17 -to "LEDR[2]"
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to "LEDR[2]"
set_location_assignment PIN_V18 -to "LEDR[3]"
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to "LEDR[3]"
set_location_assignment PIN_W17 -to "LEDR[4]"
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to "LEDR[4]"
set_location_assignment PIN_W19 -to "LEDR[5]"
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to "LEDR[5]"
set_location_assignment PIN_Y19 -to "LEDR[6]"
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to "LEDR[6]"
set_location_assignment PIN_W20 -to "LEDR[7]"
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to "LEDR[7]"
set_location_assignment PIN_W21 -to "LEDR[8]"
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to "LEDR[8]"
set_location_assignment PIN_Y21 -to "LEDR[9]"
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to "LEDR[9]"
set_global_assignment -name VERILOG_FILE "de1_soc_top.v"
set_global_assignment -name VERILOG_FILE "de1_clock.v"
set_global_assignment -name VERILOG_FILE "../../Source Code/TPM_TOP.v"
