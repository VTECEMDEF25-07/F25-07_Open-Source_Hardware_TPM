# Filename: run_module_common.do
# Author: Script completely generated by Codex
# Date: October 13, 2026
# Description: Shared compile/run/waveform setup; invoked by one run_<module>.do file.
# GUI keeps results open. Batch returns failure if compile or assertions fail.
if {[batch_mode]} {onerror {quit -force -code 1}} else {onerror {abort}}
onbreak {resume}
set project_root {C:/MDE/F25-07_Open-Source_Hardware_TPM}
if {[info exists env(TPM_PROJECT_ROOT)]} {set project_root $env(TPM_PROJECT_ROOT)}
set sym_root [file join $project_root {Symmetric Module}]
set run_base {C:/MDE/review_work/symmetric_module_tests_20261013}
if {[info exists env(TPM_TEST_RUN_ROOT)]} {set run_base $env(TPM_TEST_RUN_ROOT)}
set run_root [file join $run_base $module_test "run_[clock clicks]_[pid]"]
file mkdir $run_root
cd $run_root
transcript file [file join $run_root transcript.log]
vlib work_module
switch $module_test {
    cfb_block {
        set sources {aes_sbox.v aes_inv_sbox.v aes_key_mem.v aes_encipher_block.v aes_decipher_block.v aes_core.v aes.v cfb_block.v}
        set expected_cases 7
    }
    session_parameter_controller {
        set sources {kdfa_control.v hmac_sha256_placeholder.v session_parameter_controller.v}
        set expected_cases 12
    }
    encrypt_decrypt2_controller {
        set sources {encrypt_decrypt2_controller.v}
        set expected_cases 9
    }
    default {error "Unknown module test $module_test"}
}
foreach name $sources {vlog -work work_module [file join $sym_root $name]}
set bench tb_$module_test
vlog -sv -work work_module [file join $sym_root Testbenches ${bench}.sv]
vsim -voptargs=+acc -onfinish stop -wlf [file join $run_root vsim.wlf] -lib work_module $bench
set root sim:/$bench
log -r $root/*

if {![batch_mode]} {
    view wave
    add wave -group {Case and clock} -radix unsigned $root/test_case
    add wave -group {Case and clock} $root/clock_i $root/reset_n_i
    add wave -group {Caller handshake} $root/start_i $root/wait_o $root/done_o
    add wave -group {Inputs} -radix unsigned $root/data_bytes_i
    add wave -group {Inputs} -radix hexadecimal $root/data_in_i $root/iv_i
    add wave -group {Controller state} -radix unsigned $root/dut/state_r
    if {$module_test eq "cfb_block"} {
        add wave -group {Inputs} $root/decrypt_i
        add wave -group {Inputs} -radix hexadecimal $root/key_i
        add wave -group {AES handshake} $root/dut/aes_init_r $root/dut/aes_next_r $root/dut/aes_ready_w $root/dut/aes_result_valid_w
        add wave -group {AES and CFB} -radix hexadecimal $root/dut/aes_key_r $root/dut/aes_feedback_r $root/dut/cipher_stream_block_w $root/dut/cfb_result_w $root/dut/cfb_feedback_w
    } else {
        add wave -group {Prepared CFB request} $root/cfb_start_o $root/cfb_decrypt_o
        add wave -group {Prepared CFB request} -radix unsigned $root/cfb_bytes_o $root/cfb_calls
        add wave -group {Prepared CFB request} -radix hexadecimal $root/cfb_key_o $root/cfb_iv_o $root/cfb_data_o
        add wave -group {Mock worker response} -radix unsigned $root/response_delay
        add wave -group {Mock worker response} $root/cfb_done_i
        add wave -group {Mock worker response} -radix hexadecimal $root/cfb_rc_i $root/cfb_data_i $root/cfb_iv_i
        if {$module_test eq "session_parameter_controller"} {
            add wave -group {Session selection} $root/session_use_xor_i $root/session_decrypt_i $root/session_encrypt_i $root/session_valid_i
            add wave -group {Session inputs} -radix hexadecimal $root/session_value_i $root/nonce_newer_i $root/nonce_older_i
            add wave -group {HMAC requests} $root/dut/hmac_req_valid_w $root/dut/hmac_req_ready_w
            add wave -group {HMAC requests} -radix unsigned $root/message_counter $root/hmac_calls
            add wave -group {HMAC requests} -radix hexadecimal $root/dut/hmac_key_w $root/dut/hmac_message_w
            add wave -group {HMAC responses} $root/dut/hmac_rsp_valid_w $root/dut/hmac_rsp_ready_w $root/dut/hmac_error_w
            add wave -group {HMAC responses} -radix hexadecimal $root/dut/hmac_digest_w
            add wave -group {Derived material} $root/dut/kdfa_rsp_valid_w $root/dut/kdfa_error_w
            add wave -group {Derived material} -radix hexadecimal $root/dut/kdfa_key_w $root/dut/kdfa_iv_w
        } else {
            add wave -group {Command checks} -radix hexadecimal $root/command_code_i
            add wave -group {Command checks} $root/key_valid_i $root/decrypt_i
            add wave -group {Command checks} -radix unsigned $root/mode_i
        }
    }
    add wave -group {Final result} -radix hexadecimal $root/tpm_rc_o $root/data_out_o $root/iv_out_o
    configure wave -namecolwidth 250 -valuecolwidth 240 -timelineunits ns
}

run -all
if {[examine -radix unsigned $root/successfully_completed] != 1} {error "Module test did not finish successfully"}
set count [examine -radix unsigned $root/case_count]
if {$count != $expected_cases} {error "Expected $expected_cases cases, got $count"}
puts "MODULE_SUITE_PASS: $module_test ($count cases)"
puts "Saved waveforms: [file join $run_root vsim.wlf]"
puts "Saved transcript: [file join $run_root transcript.log]"
if {[batch_mode]} {
    quit -force -code 0
} else {
    wave zoom full
    puts {Simulation remains open. test_case identifies each case; see WAVEFORM_GUIDE.md.}
}
